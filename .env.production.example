# Production .env for the EC2 server (copy to .env there; never commit it).
# See deploy/README.md. Generate secrets with: openssl rand -hex 32

# Public hostnames (both must point at the server's Elastic IP).
# Without a domain, sslip.io names work: app.13-48-1-2.sslip.io
APP_DOMAIN=
VOICE_DOMAIN=

# Backend
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SERVICE_API_KEY=

# PostgreSQL (db service). docker-compose.prod.yml refuses to start without it
POSTGRES_PASSWORD=

# AI agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Twilio (the auth token also verifies webhook signatures)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TTS_PROVIDER=ElevenLabs
TTS_VOICE=UgBBYS2sOqTuMpoF3BR0-flash_v2_5

# Browser demo phone: a Twilio API key (Console > Account > API keys) and
# the TwiML app whose voice URL points at voice-bridge's /voice
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# Quote SMS after a quoted call: aws (EC2 instance role, no keys here),
# smsportal (API keys below) or twilio (default when unset)
SMS_PROVIDER=aws
AWS_REGION=eu-north-1
AWS_SMS_ORIGINATION_IDENTITY=
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=
SMSPORTAL_TEST_MODE=false

# Quote email when the caller gives an address: ses (Amazon SES, EC2
# instance role, region AWS_REGION) or none. EMAIL_FROM must be verified in SES.
EMAIL_PROVIDER=none
EMAIL_FROM=
