# Public entrypoint in production. Caddy gets and renews Let's Encrypt
# certificates for both hostnames automatically; everything else stays on
# the internal Docker network.

# Staff dashboard (nginx in the frontend container also proxies /api)
{$APP_DOMAIN} {
	encode gzip

	# Security headers. Deleting Server makes Caddy apply these after the
	# proxied response, so they win over anything nginx or FastAPI sends.
	#
	# CSP: the bundle is only same-origin scripts (no inline scripts, no
	# eval). Fonts come from Google Fonts. The demo phone's Twilio Voice
	# SDK opens wss://voice-js.<edge>.twilio.com, posts call insights to
	# https://eventgw[.<region>].twilio.com and loads ringtones from
	# https://sdk.twilio.com; WebRTC audio itself is not governed by CSP.
	# 'unsafe-inline' styles cover style attributes from React and charts.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob: https://sdk.twilio.com; connect-src 'self' https://*.twilio.com wss://*.twilio.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
	}

	reverse_proxy frontend:80
}

# Twilio webhook (/voice) and ConversationRelay WebSocket. Twilio is the
# only client, so these are hardening basics rather than a browser policy.
{$VOICE_DOMAIN} {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	reverse_proxy voice-bridge:5000
}
