  "/leads/": {
   "post": {
    "tags": [
     "Lead Management"
    ],
    "summary": "Create Lead",
    "description": "Orchestrate lead creation from a call event or a manual log\n(Admin or service key).\n\nPass `quote` when one was already given on the call; otherwise the\npricing server is asked for one from `job_details`.",
    "operationId": "create_lead_leads__post",
    "security": [
     {
      "OAuth2PasswordBearer": []
     }
    ],
    "parameters": [
     {
      "name": "name",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Name"
      }
     },
     {
      "name": "contact",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Contact"
      }
     },
     {
      "name": "call_sid",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Call Sid"
      }
     },
     {
      "name": "quote",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "title": "Quote"
      }
     },
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "new",
        "contacted",
        "confirmed",
        "closed",
        "incomplete"
       ],
       "type": "string",
       "default": "new",
       "title": "Status"
      }
     },
     {
      "name": "x-service-key",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Service-Key"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "additionalProperties": true,
        "title": "Job Details"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
