  "/notifications/": {
   "post": {
    "tags": [
     "Notifications"
    ],
    "summary": "Create Notification",
    "description": "Log an SMS or email notification in the database.\nIntended for trusted backend services such as the Voice Bridge.",
    "operationId": "create_notification_notifications__post",
    "security": [
     {
      "OAuth2PasswordBearer": []
     }
    ],
    "parameters": [
     {
      "name": "type",
      "in": "query",
      "required": true,
      "schema": {
       "enum": [
        "sms",
        "email"
       ],
       "type": "string",
       "title": "Type"
      }
     },
     {
      "name": "recipient",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Recipient"
      }
     },
     {
      "name": "message",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Message"
      }
     },
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "enum": [
        "sent",
        "failed"
       ],
       "type": "string",
       "default": "sent",
       "title": "Status"
      }
     },
     {
      "name": "subject",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Subject"
      }
     },
     {
      "name": "provider_id",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Provider Id"
      }
     },
     {
      "name": "x-service-key",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Service-Key"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/NotificationOut"
        }
       }
