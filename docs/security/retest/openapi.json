  "/pricing/calculate": {
   "post": {
    "tags": [
     "Pricing Engine"
    ],
    "summary": "Calculate Price",
    "description": "Compute a price estimate via the MCP pricing service (Admin or service key).\n\nReturns 502 if the pricing server is down and 422 if it can't price the\ngiven factors, so a failed lookup never comes back as an R0 estimate.",
    "operationId": "calculate_price_pricing_calculate_post",
    "security": [
     {
      "OAuth2PasswordBearer": []
     }
    ],
    "parameters": [
     {
      "name": "x-service-key",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Service-Key"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "additionalProperties": true,
        "title": "Factors"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
