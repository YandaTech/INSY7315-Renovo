# Copy to .env and fill in. Used by docker-compose to configure the
# backend container (see docker-compose.yml / docker-compose.prod.yml).

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Anthropic
ANTHROPIC_API_KEY=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Voice bridge / AI agent wiring (haiku branch)
BACKEND_API_URL=http://localhost:8000
PRICING_SERVER_URL=http://localhost:8001/mcp/pricing
AI_AGENT_URL=http://localhost:8002
CONVERSATION_RELAY_WS_URL=
