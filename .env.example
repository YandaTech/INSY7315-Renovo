# Copy to .env and fill in. Used by docker-compose to configure the
# backend container (see docker-compose.yml / docker-compose.prod.yml),
# and read directly by voice-bridge, ai-agent, and mcp-pricing-server when
# run locally. Contains every variable used across all branches (main,
# haiku, voice) so this file doesn't change shape when you switch branches.

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Anthropic (ai-agent, haiku branch)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (ai-agent, voice branch)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Service URLs: backend <-> voice-bridge <-> ai-agent <-> mcp-pricing-server
BACKEND_API_URL=http://localhost:8000
PRICING_SERVER_URL=http://localhost:8001/mcp/pricing
AI_AGENT_URL=http://localhost:8002
AI_AGENT_WS_URL=ws://localhost:8002

# Twilio WebSocket target for voice-bridge (haiku branch: ConversationRelay
# text protocol; voice branch: raw Media Streams audio). Leave blank to
# default to wss://<request host>/ for local dev.
CONVERSATION_RELAY_WS_URL=
MEDIA_STREAM_WS_URL=

# ConversationRelay TTS voice (haiku branch only). Ayanda is Amazon Polly's
# South African English voice. Voice IDs here are bare - no "Polly." prefix
# (that's only for <Say>). Confirmed from Twilio's own ConversationRelay
# docs example: ttsProvider="amazon" voice="Elin-Neural".
TTS_PROVIDER=amazon
TTS_VOICE=Ayanda-Neural

# Renovo Backend JWT Security
SECRET_KEY=renovo-super-secret-development-key-2026-secure!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
