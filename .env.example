# Copy to .env and fill in. docker-compose.yml loads it into the backend,
# ai-agent and voice-bridge containers, and the services read it directly
# when run outside Docker. Production uses .env.production.example instead.

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Quote SMS sender when no Messaging Service is set: an SMS-capable Twilio number
TWILIO_FROM_NUMBER=

# Quote SMS gateway: aws, smsportal or twilio (default twilio)
# aws = AWS End User Messaging SMS, signed by the server's EC2 instance role (no AWS keys here)
SMS_PROVIDER=smsportal
AWS_REGION=eu-north-1
# aws sender: a sender ID, phone number or pool ID/ARN; blank lets AWS choose
AWS_SMS_ORIGINATION_IDENTITY=
# SMSPortal REST API key (Control Panel > Settings > API Keys)
SMSPORTAL_CLIENT_ID=
SMSPORTAL_API_SECRET=
# true = SMSPortal validates the send but delivers nothing and charges nothing
SMSPORTAL_TEST_MODE=false

# Anthropic (ai-agent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Quote email when the caller gives an address: ses or none (default none)
# ses = Amazon SES, signed by the server's EC2 instance role (no AWS keys
# here) in AWS_REGION. EMAIL_FROM must be an SES-verified sender.
EMAIL_PROVIDER=none
EMAIL_FROM=

# Service URLs: backend <-> voice-bridge <-> ai-agent <-> mcp-pricing-server
BACKEND_API_URL=http://localhost:8000
PRICING_SERVER_URL=http://localhost:8001/mcp/pricing
AI_AGENT_URL=http://localhost:8002

# ConversationRelay WebSocket URL that voice-bridge gives Twilio. Leave
# blank to default to wss://<request host>/ for local dev.
CONVERSATION_RELAY_WS_URL=

# ConversationRelay TTS voice. ElevenLabs sounds most natural; the voice is
# an ElevenLabs voice ID with an optional model suffix (flash_v2_5 = lowest
# latency). UgBBYS2sOqTuMpoF3BR0 is Twilio's default English voice. To go
# back to Amazon Polly: TTS_PROVIDER=amazon, TTS_VOICE=Ayanda-Neural. An
# invalid combination makes Twilio reject calls (error 64101).
TTS_PROVIDER=ElevenLabs
TTS_VOICE=UgBBYS2sOqTuMpoF3BR0-flash_v2_5

# Renovo Backend JWT Security
SECRET_KEY=renovo-super-secret-development-key-2026-secure!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared secret voice-bridge sends to the backend (X-Service-Key) to save
# calls and leads. Use a long random value outside local dev.
SERVICE_API_KEY=renovo-dev-service-key

# Browser origins allowed to call the backend directly (comma-separated).
# The frontend normally goes through the /api proxy, so this rarely matters.
CORS_ORIGINS=http://localhost:5173

# voice-bridge port when run outside Docker. macOS AirPlay holds 5000, so
# set this (e.g. 5050) on a Mac and point ngrok at the same port.
PORT=5000

# Browser demo phone: a Twilio API key (Console > Account > API keys) and
# the TwiML app whose voice URL points at voice-bridge's /voice
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
